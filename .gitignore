# Configuração local (nunca versionar)
.env

# Python
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/

# Dados gerados pelo pipeline (o aluno os produz ao executar).
# As pastas do medallion ficam no repo (via .gitkeep); o CONTEÚDO é gerado.
# ATENÇÃO: data/raw/ É versionado — são as fontes da atividade.
data/bronze/*
data/silver/*
data/gold/*
!data/bronze/.gitkeep
!data/silver/.gitkeep
!data/gold/.gitkeep
data/*.duckdb          # analytics.duckdb (catálogo) e chamados_oltp.duckdb (OLTP simulado)
data/*.duckdb.wal

# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/.user.yml

# Logs e temporários
*.log
*.tmp

# Sistema operacional / IDEs
.DS_Store
Thumbs.db
.idea/
.vscode/

# Config local do Claude/editor
.claude/

# Jupyter
.ipynb_checkpoints/

# Artefatos da extensão do dbt (engine Fusion) — documentação da ferramenta,
# não do projeto. Se quiser versioná-los, remova estas duas linhas.
dbt/AGENTS.md
dbt/manual_fixes/
